{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/src",
        },
        {
            "type": "node",
            "request": "launch",
            "name": "API",
            "program": "${workspaceFolder}/backend/api_server.js",
            "console": "integratedTerminal",
            "restart": true
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Inventory",
            "program": "${workspaceFolder}/experimental/inv_server.js",
            "console": "integratedTerminal",
            "restart": true
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Vite",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "npm",
            "runtimeArgs": [ "run", "dev" ],
            "console": "integratedTerminal"
        },
         {
            "type": "node",
            "request": "launch",
            "name": "debug API",
            "program": "${workspaceFolder}/backend/craft_logic_dbg.js",
            "console": "integratedTerminal",
            "restart": true
        },
    ],
    "compounds": [
        {
            "name": "🚀 Запустить всё вместе",
            "configurations": [ "API", "Inventory", "Vite", "Chrome" ],
            "stopAll": true
        }
    ]
}